rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function allowedWorkspace(workspace) {
      return workspace == 'master-ai-beta';
    }

    function memberPath(workspace) {
      return /databases/$(database)/documents/workspaces/$(workspace)/members/$(request.auth.uid);
    }

    function hasActiveMember(workspace) {
      return signedIn()
        && allowedWorkspace(workspace)
        && exists(memberPath(workspace))
        && get(memberPath(workspace)).data.active != false;
    }

    function role(workspace) {
      // Old dispatcher/logistic profiles stay usable as the single combined
      // dispatcher-logistic role. There is no longer a separate limited role.
      return hasActiveMember(workspace)
        ? (get(memberPath(workspace)).data.role in ['dispatcher', 'logistic']
            ? 'dispatcher_logistic'
            : get(memberPath(workspace)).data.role)
        : '';
    }

    function isOwner(workspace) {
      return role(workspace) == 'owner';
    }

    function isOps(workspace) {
      return role(workspace) in ['owner', 'dispatcher_logistic', 'logistic'];
    }

    function isDispatcher(workspace) {
      return role(workspace) == 'dispatcher';
    }

    function isMaster(workspace) {
      return role(workspace) == 'master';
    }

    function isShiftCloser(workspace) {
      return role(workspace) in ['dispatcher_logistic', 'logistic'];
    }

    function shiftReportPath(workspace, reportId) {
      return /databases/$(database)/documents/workspaces/$(workspace)/shiftReports/$(reportId);
    }

    function shiftClosurePath(workspace, closureId) {
      return /databases/$(database)/documents/workspaces/$(workspace)/shiftClosures/$(closureId);
    }

    function orderPath(workspace, orderId) {
      return /databases/$(database)/documents/workspaces/$(workspace)/orders/$(orderId);
    }

    function dispatcherOrderPath(workspace, orderId) {
      return /databases/$(database)/documents/workspaces/$(workspace)/dispatcherOrders/$(orderId);
    }

    function reportHasOrder(workspace, date, shift, orderId) {
      let path = shiftReportPath(workspace, date + '-' + shift);
      return date is string && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && exists(path) && get(path).data.orderIds is list
        && orderId in get(path).data.orderIds;
    }

    function reportHasPaidOrder(workspace, reportId, orderId) {
      let path = shiftReportPath(workspace, reportId);
      return exists(path) && get(path).data.paidOrderIds is list
        && orderId in get(path).data.paidOrderIds;
    }

    function reportHasLockedOrder(workspace, reportId, orderId) {
      let report = shiftReportPath(workspace, reportId);
      let closure = shiftClosurePath(workspace, reportId);
      return (exists(report) && get(report).data.lockedOrderIds is list
          && orderId in get(report).data.lockedOrderIds)
        || (exists(closure) && get(closure).data.lockedOrderIds is list
          && orderId in get(closure).data.lockedOrderIds);
    }

    function hasReportLockMarker(workspace, data, orderId) {
      let markedReport = data.get('_reportLockId', '');
      let canonicalPath = orderPath(workspace, orderId);
      let canonicalExists = exists(canonicalPath);
      let canonical = canonicalExists ? get(canonicalPath).data : data;
      let mirrorPath = dispatcherOrderPath(workspace, orderId);
      let mirrorExists = exists(mirrorPath);
      let mirror = mirrorExists ? get(mirrorPath).data : data;
      let canonicalReport = canonical.get('_reportLockId', '');
      let mirrorReport = mirror.get('_reportLockId', '');
      let reportId = markedReport != '' ? markedReport
        : (canonicalReport != '' ? canonicalReport : mirrorReport);
      return reportId is string
        && reportId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}-(sergey|artem)$')
        && reportHasLockedOrder(workspace, reportId, orderId);
    }

    function hasPickupReportLock(workspace, data, orderId) {
      let cashDate = data.get('_cashClosedOn', '');
      return hasReportLockMarker(workspace, data, orderId)
        || (cashDate is string && cashDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (reportHasOrderPaidOnDate(workspace, cashDate, 'sergey', orderId)
            || reportHasOrderPaidOnDate(workspace, cashDate, 'artem', orderId)));
    }

    function reportHasOrderPaidOnDate(workspace, date, shift, orderId) {
      let path = shiftReportPath(workspace, date + '-' + shift);
      return exists(path) && get(path).data.paidOrderIds is list
        && orderId in get(path).data.paidOrderIds;
    }

    function isPickupOrder(data) {
      return data.get('_isPickup', false) == true
        || data.get('_status', '') == 'Забор / техника у мастера';
    }

    // A regular order freezes only when a closed shift report lists its ID.
    // Pickups are exempt from their original day's report; they freeze only
    // after appearing in a settlement report's paidOrderIds.
    function isFinalOrder(workspace, data, orderId) {
      return isPickupOrder(data)
        ? hasPickupReportLock(workspace, data, orderId)
        : (hasReportLockMarker(workspace, data, orderId)
          || reportHasOrder(workspace, data.get('callDate', ''), 'sergey', orderId)
          || reportHasOrder(workspace, data.get('callDate', ''), 'artem', orderId));
    }

    function isTerminalOrder(data) {
      return (data.keys().hasAny(['_status'])
          && data._status in ['Выполнен', 'Закрыт', 'Закрыто', 'Отказ', 'Отмена'])
        || (data.keys().hasAny(['_masterStage']) && data._masterStage == 'approved')
        || (data.keys().hasAny(['_closeReviewState']) && data._closeReviewState == 'approved')
        || (data.keys().hasAny(['_cashClosedAt']) && data._cashClosedAt != '')
        || (data.keys().hasAny(['closeDate']) && data.closeDate != '');
    }

    function reportLockUnchanged(workspace, orderId) {
      let oldId = resource.data.get('_reportLockId', '');
      let newId = request.resource.data.get('_reportLockId', '');
      let safeId = newId is string && newId != '' ? newId : 'invalid';
      let path = shiftClosurePath(workspace, safeId);
      let member = get(memberPath(workspace)).data;
      let memberId = member.keys().hasAny(['id']) ? member.id : request.auth.uid;
      let report = existsAfter(path) ? getAfter(path).data : {};
      return newId == oldId
        || (isShiftCloser(workspace) && oldId == ''
          && newId is string
          && newId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}-(sergey|artem)$')
          && existsAfter(path)
          && report.closedBy == memberId
          && report.lockedOrderIds is list
          && orderId in report.lockedOrderIds);
    }

    function pickupMarkerValid() {
      let oldPickup = resource.data.get('_isPickup', false);
      let newPickup = request.resource.data.get('_isPickup', false);
      return oldPickup == newPickup
        || (oldPickup != true && newPickup == true
          && resource.data.get('_status', '') == 'Забор / техника у мастера');
    }

    function validStaffOrderCreate() {
      let data = request.resource.data;
      return !isTerminalOrder(data)
        && !data.keys().hasAny(['_reportLockId'])
        && (!data.get('_isPickup', false) || data.get('_status', '') == 'Забор / техника у мастера')
        && !data.keys().hasAny(['pp','parts','cleanCheck','total','masterAmount','companyShare']);
    }

    function validPickupCreate(data) {
      return !data.get('_isPickup', false)
        || data.get('_status', '') == 'Забор / техника у мастера';
    }

    // Client-facing operational edits are intentionally allow-listed. Any new
    // field remains owner-only until it has been reviewed and added here.
    function operationalOrderFields() {
      return [
        'orderId','a0','_origin','direction','city','callDate','callTime','visitDate','visitTime',
        'name','phone','address','request','master','dispatcher','review','closeDate','_isPickup',
        // Only logistics roles can edit order-level closing amounts, and only
        // before the order is final. Payroll, expenses and rate settings remain owner-only.
        'pp','parts','cleanCheck','total','masterAmount','companyShare',
        '_status','_updatedAt','_updatedBy','_updatedByName','_updatedByShift',
        '_assignedAt','_assignedBy','_assignedByName','_workflow','_workflowCreatedAt',
        '_requiresCloseApproval','_masterStage','_closeReviewState','_closeReviewNote',
        '_closeApprovedAt','_closeApprovedBy','_closeApprovedByName',
        '_phoneUnlockAt','_showPhoneToMaster','_doneAt','_workCompletedAt','_cashClosedAt','_cashClosedOn','_cashClosedBy',
        '_cashClosedByName'
      ];
    }

    function operationalCreateFields() {
      return operationalOrderFields().concat([
        '_createdAt','_createdBy','_createdByName','_createdByShift'
      ]);
    }

    function dispatcherMirrorFields() {
      return [
        'orderId','direction','city','callDate','callTime','visitDate','visitTime','_isPickup','_reportLockId',
        'name','phone','address','request','master','dispatcher','closeDate',
        '_status','_showPhoneToMaster','_createdAt','_updatedAt','_createdBy',
        '_createdByName','_createdByShift','_updatedBy','_updatedByName',
        '_updatedByShift','_assignedAt','_assignedBy','_assignedByName','_workflow',
        '_workflowCreatedAt','_requiresCloseApproval','_masterStage','_acceptedAt',
        '_enrouteAt','_arrivedAt','_workAt','_doneAt','_workCompletedAt',
        '_masterNote','_masterReportAt','_reviewSubmittedAt','_reviewReturnedAt',
        '_reviewReturnedBy','_reviewReturnedByName','_closeReviewState',
        '_closeReviewNote','_closeApprovedAt','_closeApprovedBy','_closeApprovedByName'
      ];
    }

    function dispatcherOpsMirrorFields() {
      return dispatcherMirrorFields().concat(['review']);
    }

    function masterAssignmentFields() {
      return [
        'orderId','direction','city','callDate','callTime','visitDate','visitTime','name','address','_isPickup','_reportLockId',
        'request','master','masterUid','masterKey','dispatcher','review','closeDate',
        '_status','_showPhoneToMaster','_assignedAt','_assignedBy','_assignedByName',
        '_workflow','_workflowCreatedAt','_requiresCloseApproval','_masterStage',
        '_acceptedAt','_enrouteAt','_arrivedAt','_workAt','_doneAt','_updatedAt',
        '_phoneUnlockAt','_masterReportedTotal','_masterReportedParts',
        '_masterReportedReview','_masterNote','_masterReportAt','_workCompletedAt',
        '_reviewSubmittedAt','_reviewReturnedAt','_reviewReturnedBy',
        '_reviewReturnedByName','_closeReviewState','_closeReviewNote',
        '_closeApprovedAt','_closeApprovedBy','_closeApprovedByName'
      ];
    }

    function validMasterShift(workspace, date) {
      let member = get(memberPath(workspace)).data;
      let memberId = member.keys().hasAny(['id']) ? member.id : request.auth.uid;
      return request.resource.data.keys().hasOnly([
          'date','masters','updatedBy','updatedByName','updatedAt','serverUpdatedAt'
        ])
        && request.resource.data.date == date
        && date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.masters is list
        && request.resource.data.masters.size() <= 100
        && request.resource.data.updatedBy == memberId
        && request.resource.data.updatedByName == member.name
        && request.resource.data.serverUpdatedAt == request.time;
    }

    function readsOwnShiftReport(workspace) {
      let member = get(memberPath(workspace)).data;
      let memberId = member.keys().hasAny(['id']) ? member.id : request.auth.uid;
      return isShiftCloser(workspace) && resource.data.closedBy == memberId;
    }

    function validShiftClosure(workspace, closureId) {
      let data = request.resource.data;
      let member = get(memberPath(workspace)).data;
      let memberId = member.keys().hasAny(['id']) ? member.id : request.auth.uid;
      return data.keys().hasOnly([
          'id','date','shift','shiftName','closedBy','closedByName','closedAt',
          'serverClosedAt','orderIds','lockedOrderIds'
        ])
        && data.id == closureId
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.shift in ['sergey','artem']
        && closureId == data.date + '-' + data.shift
        && data.shift == member.shift
        && data.closedBy == memberId
        && data.closedByName == member.name
        && data.shiftName is string
        && data.closedAt is string
        && data.serverClosedAt == request.time
        && data.orderIds is list && data.orderIds.size() <= 500
        && data.lockedOrderIds is list && data.lockedOrderIds.size() <= 500;
    }

    function readsOwnShiftClosure(workspace) {
      let member = get(memberPath(workspace)).data;
      let memberId = member.keys().hasAny(['id']) ? member.id : request.auth.uid;
      return isShiftCloser(workspace) && resource.data.closedBy == memberId;
    }

    function payrollPath(workspace) {
      return /databases/$(database)/documents/workspaces/$(workspace)/config/payroll;
    }

    function validOwnerShiftReport(workspace, reportId) {
      let data = request.resource.data;
      let owner = get(memberPath(workspace)).data;
      let ownerId = owner.keys().hasAny(['id']) ? owner.id : request.auth.uid;
      let configured = exists(payrollPath(workspace));
      let basePay = configured && get(payrollPath(workspace)).data.keys().hasAny(['shiftBasePay'])
        ? get(payrollPath(workspace)).data.shiftBasePay : 2000;
      let threshold = configured && get(payrollPath(workspace)).data.keys().hasAny(['shiftCashThreshold'])
        ? get(payrollPath(workspace)).data.shiftCashThreshold : 20000;
      let rate = configured && get(payrollPath(workspace)).data.keys().hasAny(['shiftCashRate'])
        ? get(payrollPath(workspace)).data.shiftCashRate : 10;
      let percentageMatchesWholeRuble = data.salary * 100 >= data.cash * rate - 50
        && data.salary * 100 <= data.cash * rate + 50;
      return data.keys().hasAll([
          'id','date','closedBy','closedByName','shift','shiftName','orders','financialOrders',
          'completed','active','refused','cancelled','unassigned','reviewPending','reviews',
          'reviewRate','turnover','cash','avgCheck','salary','basePay','cashThreshold','cashRate',
          'orderIds','dataHash','closedAt','serverClosedAt','subjectMemberId','approvedFor',
          'approvedForName','ownerConfirmed','ownerApprovedBy','ownerApprovedByName',
          'ownerApprovedAt','serverApprovedAt'
        ])
        && data.keys().hasOnly([
          'id','date','closedBy','closedByName','shift','shiftName','orders','financialOrders',
          'completed','active','refused','cancelled','unassigned','reviewPending','reviews',
          'reviewRate','turnover','cash','avgCheck','salary','basePay','cashThreshold','cashRate',
          'orderIds','dataHash','closedAt','serverClosedAt','settlementVersion','shiftCash',
          'lockedOrderIds',
          'deferredCash','paidOrderIds','deferredOrderIds','subjectMemberId','approvedFor',
          'approvedForName','ownerConfirmed','ownerApprovedBy','ownerApprovedByName',
          'ownerApprovedAt','serverApprovedAt'
        ])
        && data.id == reportId
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.shift in ['sergey','artem']
        && reportId == data.date + '-' + data.shift
        && data.closedBy == ownerId
        && data.ownerApprovedBy == ownerId
        && data.ownerApprovedByName == owner.name
        && data.ownerConfirmed == true
        && data.subjectMemberId is string
        && data.subjectMemberId.size() > 0
        && data.approvedFor == data.subjectMemberId
        && data.approvedForName is string
        && data.approvedForName.size() > 0
        && data.serverClosedAt == request.time
        && data.serverApprovedAt == request.time
        && data.basePay == basePay
        && data.cashThreshold == threshold
        && data.cashRate == rate
        && (data.cash > threshold ? percentageMatchesWholeRuble : data.salary == basePay)
        && data.orders is int && data.orders >= 0
        && data.financialOrders is int && data.financialOrders >= 0
        && data.completed is int && data.completed >= 0
        && data.reviews is int && data.reviews >= 0
        && data.cash is number && data.cash >= 0
        && data.turnover is number && data.turnover >= 0
        && data.salary is number && data.salary >= 0
        && data.orderIds is list && data.orderIds.size() <= 500
        && (!data.keys().hasAny(['lockedOrderIds'])
          || (data.lockedOrderIds is list && data.lockedOrderIds.size() <= 500))
        && data.dataHash is string
        && (!data.keys().hasAny(['settlementVersion'])
          || (data.settlementVersion == 1
            && data.keys().hasAll(['shiftCash','deferredCash','paidOrderIds','deferredOrderIds'])
            && data.paidOrderIds is list && data.paidOrderIds.size() <= 500
            && data.deferredOrderIds is list && data.deferredOrderIds.size() <= data.paidOrderIds.size()
            && request.resource.data.shiftCash + request.resource.data.deferredCash == request.resource.data.cash));
    }

    function validWeeklyShiftReport(workspace, weekId) {
      let data = request.resource.data;
      let member = get(memberPath(workspace)).data;
      let memberId = member.keys().hasAny(['id']) ? member.id : request.auth.uid;
      return data.keys().hasAll([
          'id', 'start', 'end', 'closedBy', 'closedByName', 'closedAt', 'serverClosedAt',
          'closedShifts', 'expectedShifts', 'missingShifts', 'partial', 'orders',
          'turnover', 'cash', 'salary', 'avgCheck', 'financialOrders', 'completed',
          'reviews', 'reviewRate', 'sourceHash', 'dailyReports', 'duplicateOrders'
        ])
        && data.keys().hasOnly([
          'id', 'start', 'end', 'closedBy', 'closedByName', 'closedAt', 'serverClosedAt',
          'closedShifts', 'expectedShifts', 'missingShifts', 'partial', 'orders',
          'turnover', 'cash', 'salary', 'avgCheck', 'financialOrders', 'completed',
          'reviews', 'reviewRate', 'sourceHash', 'dailyReports', 'duplicateOrders'
        ])
        && data.id == weekId
        && data.start == weekId
        && data.start is string
        && data.start.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.end is string
        && data.end.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.closedBy == memberId
        && data.serverClosedAt == request.time
        && data.expectedShifts == 14
        && data.closedShifts is int
        && data.duplicateOrders is int
        && data.duplicateOrders == 0
        && data.closedShifts > 0
        && data.closedShifts <= 14
        && data.missingShifts is int
        && data.missingShifts >= 0
        && data.closedShifts + data.missingShifts == data.expectedShifts
        && data.partial == (data.missingShifts > 0)
        && data.dailyReports is list
        && data.dailyReports.size() == data.closedShifts
        && data.orders is int
        && data.orders >= 0
        && data.financialOrders is int
        && data.financialOrders >= 0
        && data.salary >= 0
        && data.cash >= 0
        && data.turnover >= 0
        && data.reviewRate >= 0
        && data.reviewRate <= 100
        && data.sourceHash is string;
    }

    function assignmentPath(workspace, orderId) {
      return /databases/$(database)/documents/workspaces/$(workspace)/masterAssignments/$(orderId);
    }

    function ownsAssignment(workspace, orderId) {
      return isMaster(workspace)
        && exists(assignmentPath(workspace, orderId))
        && get(assignmentPath(workspace, orderId)).data.masterUid == request.auth.uid;
    }

    function dispatcherFields() {
      return [
        'orderId','direction','city','callDate','callTime','visitDate','visitTime','_isPickup',
        'name','phone','address','request','dispatcher','_status',
        '_createdAt','_updatedAt','_createdBy','_createdByName','_createdByShift',
        '_updatedBy','_updatedByName','_updatedByShift'
      ];
    }

    function validCreatorIdentity(workspace, orderId) {
      let member = get(memberPath(workspace)).data;
      return request.resource.data.orderId == orderId
        && orderId.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$')
        && request.resource.data._createdBy == member.id
        && request.resource.data._createdByName == member.name
        && request.resource.data._createdByShift == member.shift
        && request.resource.data.dispatcher == member.name
        && validUpdateIdentity(workspace);
    }

    function validUpdateIdentity(workspace) {
      let member = get(memberPath(workspace)).data;
      return request.resource.data._updatedBy == member.id
        && request.resource.data._updatedByName == member.name
        && request.resource.data._updatedByShift == member.shift;
    }

    function closeAttributionValid(workspace) {
      let member = get(memberPath(workspace)).data;
      let memberId = member.keys().hasAny(['id']) ? member.id : request.auth.uid;
      return request.resource.data._cashClosedBy == memberId
        && request.resource.data._cashClosedByName == member.name
        && request.resource.data._cashClosedAt is string
        && request.resource.data._cashClosedAt != ''
        && request.resource.data._cashClosedOn is string
        && request.resource.data._cashClosedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function closeAttributionUnchanged() {
      return request.resource.data.get('_cashClosedBy', '') == resource.data.get('_cashClosedBy', '')
        && request.resource.data.get('_cashClosedByName', '') == resource.data.get('_cashClosedByName', '')
        && request.resource.data.get('_cashClosedAt', '') == resource.data.get('_cashClosedAt', '')
        && request.resource.data.get('_cashClosedOn', '') == resource.data.get('_cashClosedOn', '');
    }

    function orderCashAttributionValid(workspace) {
      let oldAt = resource.data.get('_cashClosedAt', '');
      let touched = request.resource.data.diff(resource.data).affectedKeys();
      let closeFields = ['_cashClosedBy','_cashClosedByName','_cashClosedAt','_cashClosedOn'];
      return !touched.hasAny(closeFields)
        || (oldAt != '' ? closeAttributionUnchanged() : closeAttributionValid(workspace));
    }

    function creatorIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'orderId','_createdAt','_createdBy','_createdByName','_createdByShift','dispatcher'
      ]);
    }

    function masterMutableFields() {
      return [
        '_masterStage','_updatedAt','_acceptedAt','_enrouteAt','_arrivedAt',
        '_workAt','_doneAt','_status','_closeReviewState',
        '_masterReportedTotal','_masterReportedParts','_masterReportedReview',
        '_masterNote','_masterReportAt','_workCompletedAt','_reviewSubmittedAt',
        '_requiresCloseApproval','closeDate'
      ];
    }

    function validMasterTransition() {
      let from = resource.data.get('_masterStage', '');
      let to = request.resource.data.get('_masterStage', '');
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (
        ((from == null || from == '' || from == 'assigned') && to == 'accepted'
          && changed.hasOnly(['_masterStage','_updatedAt','_acceptedAt']))
        || (from == 'accepted' && to == 'enroute'
          && changed.hasOnly(['_masterStage','_updatedAt','_enrouteAt']))
        || (from == 'enroute' && to == 'arrived'
          && changed.hasOnly(['_masterStage','_updatedAt','_arrivedAt']))
        || ((from == 'arrived' || from == 'revision_requested') && to == 'work'
          && request.resource.data._status == 'В работе'
          && changed.hasOnly(['_masterStage','_updatedAt','_workAt','_status','_closeReviewState']))
        || ((from == 'work' || from == 'revision_requested') && to == 'review_pending'
          && request.resource.data._status == 'На проверке'
          && request.resource.data._requiresCloseApproval == true
          && request.resource.data.closeDate == ''
          && changed.hasOnly(['_masterStage','_updatedAt','_status','_closeReviewState',
            '_masterReportedTotal','_masterReportedParts','_masterReportedReview',
            '_masterNote','_masterReportAt','_workCompletedAt','_reviewSubmittedAt',
            '_requiresCloseApproval','closeDate']))
        || (from == 'work' && to == 'work'
          && changed.hasOnly(['_updatedAt','_masterReportedTotal','_masterReportedParts',
            '_masterReportedReview','_masterNote','_masterReportAt']))
      );
    }

    match /workspaces/{workspace}/members/{uid} {
      allow get: if signedIn() && allowedWorkspace(workspace)
                 && (uid == request.auth.uid || isOwner(workspace)
                   || (isOps(workspace) && resource.data.role != 'owner'));
      allow list: if isOwner(workspace)
        || (isOps(workspace) && resource.data.role != 'owner');
      allow create, update, delete: if isOwner(workspace);
    }

    match /workspaces/{workspace}/orders/{orderId} {
      // Full order documents contain customer and financial records. Staff use
      // the sanitized dispatcherOrders / masterAssignments projections.
      allow get, list: if isOwner(workspace);

      allow create: if isOwner(workspace)
                    || (role(workspace) == 'dispatcher_logistic'
                        && validStaffOrderCreate()
                        && request.resource.data.keys().hasOnly(operationalCreateFields())
                        && validCreatorIdentity(workspace, orderId))
                    || (isDispatcher(workspace)
                        && !isFinalOrder(workspace, request.resource.data, orderId)
                        && validPickupCreate(request.resource.data)
                        && request.resource.data.keys().hasOnly(dispatcherFields())
                        && validCreatorIdentity(workspace, orderId));

      allow update: if isOwner(workspace)
                    || (role(workspace) in ['dispatcher_logistic','logistic']
                        && !isFinalOrder(workspace, resource.data, orderId)
                        && !isFinalOrder(workspace, request.resource.data, orderId)
                        && reportLockUnchanged(workspace, orderId) && pickupMarkerValid()
                        && orderCashAttributionValid(workspace)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(operationalOrderFields())
                        && creatorIdentityUnchanged()
                        && validUpdateIdentity(workspace))
                    || (isDispatcher(workspace)
                        && !isFinalOrder(workspace, resource.data, orderId)
                        && !isFinalOrder(workspace, request.resource.data, orderId)
                        && reportLockUnchanged(workspace, orderId) && pickupMarkerValid()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(dispatcherFields())
                        && creatorIdentityUnchanged()
                        && validUpdateIdentity(workspace))
                    || (ownsAssignment(workspace, orderId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(masterMutableFields())
                        && validMasterTransition());

      allow delete: if isOwner(workspace);
    }

    match /workspaces/{workspace}/dispatcherOrders/{orderId} {
      allow read: if hasActiveMember(workspace)
                  && role(workspace) in ['owner','dispatcher','dispatcher_logistic','logistic'];
      allow create: if isOwner(workspace)
                    || (role(workspace) in ['dispatcher','dispatcher_logistic']
                        && !isFinalOrder(workspace, request.resource.data, orderId)
                        && !request.resource.data.keys().hasAny(['_reportLockId'])
                        && request.resource.data.keys().hasOnly(role(workspace) == 'dispatcher'
                          ? dispatcherMirrorFields() : dispatcherOpsMirrorFields())
                        && validCreatorIdentity(workspace, orderId));
      allow update: if isOwner(workspace)
                    || (role(workspace) in ['dispatcher_logistic','logistic']
                        && !isFinalOrder(workspace, resource.data, orderId)
                        && reportLockUnchanged(workspace, orderId) && pickupMarkerValid()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(dispatcherOpsMirrorFields())
                        && creatorIdentityUnchanged()
                        && validUpdateIdentity(workspace))
                    || (isDispatcher(workspace)
                        && !isFinalOrder(workspace, resource.data, orderId)
                        && !isFinalOrder(workspace, request.resource.data, orderId)
                        && reportLockUnchanged(workspace, orderId) && pickupMarkerValid()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(dispatcherFields())
                        && creatorIdentityUnchanged()
                        && validUpdateIdentity(workspace));
      allow delete: if isOwner(workspace);
    }

    // Close totals are separate from the shared queue: shift closers can
    // enter/review an order's cash, while ordinary dispatchers cannot read it.
    match /workspaces/{workspace}/orderCloseData/{orderId} {
      function validOrderCloseData() {
        let member = get(memberPath(workspace)).data;
        let memberId = member.keys().hasAny(['id']) ? member.id : request.auth.uid;
        return request.resource.data.keys().hasOnly([
            'orderId','parts','total','review',
            'closeDate','_cashClosedAt','_cashClosedOn','_cashClosedBy',
            '_cashClosedByName','_updatedAt','_updatedBy','_updatedByName','_updatedByShift'
          ])
          && request.resource.data.orderId == orderId
          && request.resource.data._updatedBy == memberId
          && request.resource.data._updatedByName == member.name
          && request.resource.data._updatedByShift == member.shift;
      }
      allow get, list: if isOwner(workspace) || isShiftCloser(workspace);
      allow create: if isShiftCloser(workspace)
        && exists(orderPath(workspace, orderId))
        && !isFinalOrder(workspace, get(orderPath(workspace, orderId)).data, orderId)
        && validOrderCloseData()
        && closeAttributionValid(workspace);
      allow update: if isShiftCloser(workspace)
        && exists(orderPath(workspace, orderId))
        && !isFinalOrder(workspace, get(orderPath(workspace, orderId)).data, orderId)
        && validOrderCloseData()
        && (closeAttributionUnchanged()
            || (resource.data.get('_cashClosedAt', '') == '' && closeAttributionValid(workspace)));
      allow delete: if isOwner(workspace);
    }

    match /workspaces/{workspace}/masterAssignments/{orderId} {
      allow read: if isOwner(workspace)
                  || (isMaster(workspace) && resource.data.masterUid == request.auth.uid);

      allow create: if isOwner(workspace)
        || (isShiftCloser(workspace)
          && !request.resource.data.keys().hasAny(['_reportLockId'])
          && validPickupCreate(request.resource.data)
          && request.resource.data.keys().hasOnly(masterAssignmentFields())
          && request.resource.data.orderId == orderId);
      allow delete: if isOwner(workspace) || isShiftCloser(workspace);

      allow update: if isOwner(workspace)
                    || (isShiftCloser(workspace)
                    && !isFinalOrder(workspace, resource.data, orderId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(masterAssignmentFields()))
                    || (isMaster(workspace)
                        && !isFinalOrder(workspace, resource.data, orderId)
                        && resource.data.masterUid == request.auth.uid
                        && request.resource.data.masterUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(masterMutableFields())
                        && validMasterTransition());
    }

    match /workspaces/{workspace}/masterPhones/{orderId} {
      allow get: if isOps(workspace)
                 || (isMaster(workspace)
                     && resource.data.masterUid == request.auth.uid
                     && (resource.data.earlyAccess == true || resource.data.unlockAt <= request.time));
      allow list: if isOps(workspace);
      allow create, update, delete: if isOps(workspace);
    }

    match /workspaces/{workspace}/config/public {
      allow read: if hasActiveMember(workspace);
      allow create: if isOwner(workspace)
        || (isShiftCloser(workspace)
          && request.resource.data.keys().hasOnly([
            'phoneEveningTime','phoneNoTime','phoneNearestFutureTime','updatedAt'
          ]));
      allow update: if isOwner(workspace)
        || (isShiftCloser(workspace)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'phoneEveningTime','phoneNoTime','phoneNearestFutureTime','updatedAt'
          ]));
      allow delete: if isOwner(workspace);
    }

    match /workspaces/{workspace}/config/ui {
      allow read: if hasActiveMember(workspace);
      allow write: if isOwner(workspace);
    }

    match /workspaces/{workspace}/config/google {
      allow read, write: if isOwner(workspace);
    }

    match /workspaces/{workspace}/config/payroll {
      allow read: if isOwner(workspace);
      allow create, update, delete: if isOwner(workspace);
    }

    match /workspaces/{workspace}/config/payrollPolicy {
      allow read: if isOwner(workspace);
      allow create, update, delete: if isOwner(workspace);
    }

    match /workspaces/{workspace}/shiftReports/{reportId} {
      allow read: if isOwner(workspace)
        || readsOwnShiftReport(workspace);
      allow create: if isOwner(workspace) && validOwnerShiftReport(workspace, reportId);
      allow update, delete: if isOwner(workspace);
    }

    match /workspaces/{workspace}/shiftClosures/{closureId} {
      allow read: if isOwner(workspace) || readsOwnShiftClosure(workspace);
      allow create: if isShiftCloser(workspace) && validShiftClosure(workspace, closureId);
      allow update, delete: if isOwner(workspace);
    }

    match /workspaces/{workspace}/weeklyShiftReports/{weekId} {
      allow read: if isOwner(workspace);
      allow create, update: if isOwner(workspace) && validWeeklyShiftReport(workspace, weekId);
      allow delete: if false;
    }

    match /workspaces/{workspace}/masterShifts/{date} {
      allow read: if hasActiveMember(workspace);
      allow create, update: if isOwner(workspace)
        || (isShiftCloser(workspace) && validMasterShift(workspace, date));
      allow delete: if isOwner(workspace);
    }

    match /workspaces/{workspace}/b2bLeads/{leadId} {
      allow read, write: if false;
    }

    match /workspaces/{workspace}/uiChanges/{changeId} {
      allow read, write: if isOwner(workspace);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
