{
  "name": "master-ai-release-gate",
  "version": "18.17.19",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "gate:static": "node scripts/static-gate.mjs",
    "test:unit": "node --test tests/static-contract.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-master-ai --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "gate": "npm run gate:static && npm run test:unit && npm run test:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.30.2"
  }
}
